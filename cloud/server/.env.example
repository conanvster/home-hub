NODE_ENV=production

# Server
HTTP_PORT=3001
TCP_PORT=8090

# MongoDB
MONGO_URI=mongodb://mongo:27017/homehub

# JWT
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Sync (secret key for local server requests)
SYNC_SECRET=change_this_sync_secret

# Frontend URL (for CORS)
FRONTEND_URL=https://mytracking.com.ua

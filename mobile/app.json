{
  "expo": {
    "name": "Home Hub",
    "slug": "home-hub-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ua.com.mytracking.homehub"
    },
    "android": {
      "package": "ua.com.mytracking.homehub",
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "homehub",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Home Hub використовує геолокацію для трекінгу.",
          "locationAlwaysPermission": "Home Hub використовує фонову геолокацію для трекінгу.",
          "locationWhenInUsePermission": "Home Hub використовує геолокацію для трекінгу."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f635aa99-530a-405c-8ef5-36828b923109"
      }
    },
    "owner": "alex1864"
  }
}
